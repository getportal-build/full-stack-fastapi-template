// Starter spec, read from the code and traces by portal (no AI).
// It says what exists. Add what the code can't: domains, your names,
// rules, and what you plan to build.
// Conventions: https://portal.haris-d21.workers.dev/skills/portal-architecture/SKILL.md
model {
  system = domain 'full-stack-fastapi-template' {
    proxy = service 'proxy' {  // compose.yml:3
      technology 'traefik:3.6'
      metadata {
        otel_service 'proxy'
        resource 'proxy'
      }
    }
    db = datastore 'db' {  // compose.yml:20
      technology 'postgres:18'
      metadata {
        resource 'db'
      }
    }
    adminer = infra 'adminer' {  // compose.yml:34
      technology 'adminer'
      metadata {
        resource 'adminer'
      }
    }
    backend = service 'backend' {  // compose.yml:49
      technology 'Python · FastAPI · REST'
      metadata {
        code 'backend/**'
        otel_service 'backend'
        resource 'backend'
      }
    }
    mailpit = infra 'mailpit' {  // compose.override.yml:71
      technology 'axllent/mailpit'
      metadata {
        resource 'mailpit'
      }
    }
    Sentry = infra 'Sentry' {  // backend/pyproject.toml:19
      technology 'Sentry'
      metadata {
        resource 'Sentry'
      }
    }
    frontend = service 'frontend' {  // frontend/package.json:1
      technology 'TypeScript'
      metadata {
        code 'frontend/**'
        otel_service 'frontend'
        resource 'frontend'
      }
    }
  }

  backend -> db  // reads or writes? say which: -[reads]-> or -[writes]->
}

specification {
  element domain
  element service
  element event
  element datastore
  element infra
  element component
  relationship request
  relationship publishes
  relationship consumes
  relationship reads
  relationship writes
}
